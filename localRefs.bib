
@article{Boulkroune:2010aa,
	abstract = {This paper investigates fuzzy adaptive control schemes for a class of multi-input multi-output (MIMO) unknown nonlinear systems with known and unknown sign of the control gain matrix. Three fuzzy adaptive control schemes are developed. In the design of the second and third controller, we will exploit a decomposition of the control gain matrix into a symmetric positive-definite matrix, a diagonal matrix with diagonal entries +1 or -1 and a unity upper triangular matrix. The Nussbaum-type function is used to deal with the unknown control direction (i.e. the unknown sign of the control gain matrix). For updating the parameters of the fuzzy system, an adaptation proportional-integral (PI) law is proposed. Theoretical results are illustrated through two simulation examples.},
	author = {A. Boulkroune and M. Tadjine and M. M'Saad and M. Farza},
	date-added = {2025-02-07 12:04:21 +0100},
	date-modified = {2025-02-07 12:04:21 +0100},
	doi = {https://doi.org/10.1016/j.fss.2009.04.011},
	issn = {0165-0114},
	journal = {Fuzzy Sets and Systems},
	keywords = {Fuzzy control, Adaptive control, Adaptation PI law, MIMO nonlinear systems, Nussbaum function},
	note = {Theme: "Fuzzy Control"},
	number = {6},
	pages = {797-820},
	title = {Fuzzy adaptive controller for MIMO nonlinear systems with known and unknown control direction},
	url = {https://www.sciencedirect.com/science/article/pii/S016501140900222X},
	volume = {161},
	year = {2010},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S016501140900222X},
	bdsk-url-2 = {https://doi.org/10.1016/j.fss.2009.04.011}}


@article{Saerens:1991aa,
	abstract = { The paper investigates the possibility of using a simple approximation for evaluating the error which must be back-propagated to allow a neural net to learn to control a plant in an adaptive way. The algorithm is based on an approximation of the Jacobian of the plant. The method is applied to five simulations. The first two simulations allow a comparison between the proposed algorithm and the standard back-propagation, for which the error to be back-propagated is precisely known. The results for the two methods show equivalent performances, and equivalent convergence time, for the test problems. This shows that the rate of convergence of the neural net does not seem to depend crucially on the values of the Jacobian. The last three simulations investigate the possibility of online adaptive learning. The results show that control based on some approximation of theJacobian is possible for a neural network. },
	author = {M. Saerens and A. Soquet},
	date-added = {2025-02-20 15:53:57 +0100},
	date-modified = {2025-02-20 15:53:57 +0100},
	doi = {10.1049/ip-f-2.1991.0009},
	eprint = {https://digital-library.theiet.org/doi/pdf/10.1049/ip-f-2.1991.0009},
	issue = {1},
	journal = {IEE Proceedings F (Radar and Signal Processing)},
	pages = {55-62},
	title = {Neural controller based on back-propagation algorithm},
	url = {https://digital-library.theiet.org/doi/abs/10.1049/ip-f-2.1991.0009},
	volume = {138},
	year = {1991},
	bdsk-url-1 = {https://digital-library.theiet.org/doi/abs/10.1049/ip-f-2.1991.0009},
	bdsk-url-2 = {https://doi.org/10.1049/ip-f-2.1991.0009}}

